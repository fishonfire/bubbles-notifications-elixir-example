<Layouts.app flash={@flash}>
  <section class="space-y-8">
    <div class="overflow-hidden rounded-4xl border border-base-300 bg-linear-to-br from-base-100 via-base-100 to-base-200 shadow-xl shadow-base-300/30">
      <div class="space-y-6 px-6 py-8 sm:px-8 sm:py-10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-primary">
              <.icon name="hero-paper-airplane" class="size-4" /> Push notifications
            </div>
            <div class="space-y-2">
              <h1 class="text-3xl font-semibold tracking-tight text-base-content sm:text-4xl">
                <%= case @active_tab do %>
                  <% :device -> %>
                    Send a device push
                  <% :user_id_alias -> %>
                    Send by user ID and alias
                  <% :notification -> %>
                    Send a notification
                <% end %>
              </h1>
              <p class="max-w-2xl text-sm leading-6 text-base-content/70 sm:text-base">
                <%= case @active_tab do %>
                  <% :device -> %>
                    Target a specific device ID with a title, body, and JSON data payload through the local bubbles_notifications package.
                  <% :user_id_alias -> %>
                    Target devices by user IDs and aliases with a title, body, and JSON data payload through the local bubbles_notifications package.
                  <% :notification -> %>
                    Send an app-level notification with a title, body, and JSON data payload through the local bubbles_notifications package.
                <% end %>
              </p>
            </div>
          </div>

          <div class={[
            "inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium shadow-sm transition-colors",
            @notification_base_url_configured? &&
              "border border-success/20 bg-success/10 text-success",
            !@notification_base_url_configured? &&
              "border border-warning/20 bg-warning/10 text-warning"
          ]}>
            <.icon
              name={
                if(@notification_base_url_configured?,
                  do: "hero-check-circle",
                  else: "hero-exclamation-triangle"
                )
              }
              class="size-5"
            />
            {if(@notification_base_url_configured?,
              do: "API endpoint configured",
              else: "API endpoint missing"
            )}
          </div>
        </div>

        <div class="flex flex-wrap gap-3 rounded-3xl border border-base-300 bg-base-100/70 p-2 shadow-inner shadow-base-300/30">
          <.link
            navigate={~p"/notifications"}
            class={[
              "inline-flex items-center gap-2 rounded-2xl px-4 py-3 text-sm font-semibold transition-all duration-200",
              @active_tab == :notification &&
                "bg-primary text-primary-content shadow-md shadow-primary/20",
              @active_tab != :notification &&
                "text-base-content/70 hover:bg-base-200 hover:text-base-content"
            ]}
          >
            <.icon name="hero-megaphone" class="size-4" /> App notification
          </.link>

          <.link
            navigate={~p"/push/notifications/device"}
            class={[
              "inline-flex items-center gap-2 rounded-2xl px-4 py-3 text-sm font-semibold transition-all duration-200",
              @active_tab == :device &&
                "bg-primary text-primary-content shadow-md shadow-primary/20",
              @active_tab != :device &&
                "text-base-content/70 hover:bg-base-200 hover:text-base-content"
            ]}
          >
            <.icon name="hero-device-phone-mobile" class="size-4" /> Device push
          </.link>

          <.link
            navigate={~p"/user-id/alias"}
            class={[
              "inline-flex items-center gap-2 rounded-2xl px-4 py-3 text-sm font-semibold transition-all duration-200",
              @active_tab == :user_id_alias &&
                "bg-primary text-primary-content shadow-md shadow-primary/20",
              @active_tab != :user_id_alias &&
                "text-base-content/70 hover:bg-base-200 hover:text-base-content"
            ]}
          >
            <.icon name="hero-user-group" class="size-4" /> User ID / alias
          </.link>
        </div>

        <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
          <div class="rounded-2xl border border-base-300 bg-base-100/80 px-5 py-4 text-sm text-base-content/70 backdrop-blur sm:px-6">
            <p :if={@notification_base_url_configured?}>
              Notifications will be sent to <span class="font-medium text-base-content">{@notification_base_url}</span>.
            </p>
            <p :if={!@notification_base_url_configured?}>
              Configure <code>:bubbles_notifications</code>
              with a <code>base_url</code>
              in <code>config/runtime.exs</code>
              so the local package knows which API to call.
            </p>
          </div>

          <div class="rounded-2xl border border-base-300 bg-base-100/70 px-5 py-4 text-sm text-base-content/60 sm:px-6">
            Auth tokens are only used for the outgoing request and are not stored by this page.
          </div>
        </div>
      </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="rounded-4xl border border-base-300 bg-base-100 p-6 shadow-lg shadow-base-300/20 sm:p-8">
        <.form
          for={@form}
          id={
            case @active_tab do
              :device -> "device-push-form"
              :user_id_alias -> "user-id-alias-push-form"
              :notification -> "notification-form"
            end
          }
          action={
            case @active_tab do
              :device -> ~p"/push/notifications/device"
              :user_id_alias -> ~p"/user-id/alias"
              :notification -> ~p"/notifications"
            end
          }
          method="post"
          class="space-y-6"
        >
          <div class="grid gap-5 md:grid-cols-2">
            <.input
              field={@form[:app_id]}
              id={
                case @active_tab do
                  :device -> "device-push-app-id"
                  :user_id_alias -> "user-id-alias-push-app-id"
                  :notification -> "notification-app-id"
                end
              }
              type="number"
              min="1"
              label="App ID"
              placeholder="42"
              required
            />

            <.input
              field={@form[:auth_token]}
              id={
                case @active_tab do
                  :device -> "device-push-auth-token"
                  :user_id_alias -> "user-id-alias-push-auth-token"
                  :notification -> "notification-auth-token"
                end
              }
              type="password"
              label="Auth token"
              placeholder="Paste your bearer token"
              required
            />
          </div>

          <.input
            :if={@active_tab == :device}
            field={@form[:device_id]}
            id="device-push-device-id"
            type="text"
            label="Device ID"
            placeholder="device-123"
            required
          />

          <div :if={@active_tab == :user_id_alias} class="grid gap-5 md:grid-cols-2">
            <.input
              field={@form[:user_ids]}
              id="user-id-alias-push-user-ids"
              type="textarea"
              label="User IDs"
              rows="5"
              placeholder="user1, galaxy DG56, user 3"
            />

            <.input
              field={@form[:aliases]}
              id="user-id-alias-push-aliases"
              type="textarea"
              label="Aliases"
              rows="5"
              placeholder="alias1, alias2, alias3"
            />
          </div>

          <.input
            field={@form[:title]}
            id={
              case @active_tab do
                :device -> "device-push-title"
                :user_id_alias -> "user-id-alias-push-title"
                :notification -> "notification-title"
              end
            }
            type="text"
            label="Title"
            placeholder="Important update"
            required
          />

          <.input
            field={@form[:body]}
            id={
              case @active_tab do
                :device -> "device-push-body"
                :user_id_alias -> "user-id-alias-push-body"
                :notification -> "notification-body"
              end
            }
            type="textarea"
            label="Text"
            rows="6"
            placeholder="Write the message you want your users to receive."
            required
          />

          <.input
            field={@form[:data]}
            id={
              case @active_tab do
                :device -> "device-push-data"
                :user_id_alias -> "user-id-alias-push-data"
                :notification -> "notification-data"
              end
            }
            type="textarea"
            label="Data (JSON)"
            rows="6"
            placeholder={
              case @active_tab do
                :device -> ~s({"screen":"inbox"})
                :user_id_alias -> ~s({"type":"segment"})
                :notification -> ~s({"type":"announcement"})
              end
            }
            required
          />

          <div class="flex flex-col gap-3 border-t border-base-300 pt-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-base-content/60">
              <%= case @active_tab do %>
                <% :device -> %>
                  The request sends title, body, data, and targets one device ID.
                <% :user_id_alias -> %>
                  The request sends title, body, data, and whichever user IDs or aliases you provide.
                <% :notification -> %>
                  The request sends title, body, and data for the selected app ID.
              <% end %>
            </p>

            <.button
              variant="primary"
              class="btn btn-primary w-full sm:w-auto transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20"
            >
              <.icon name="hero-paper-airplane" class="size-4" />
              <%= case @active_tab do %>
                <% :device -> %>
                  Send device push
                <% :user_id_alias -> %>
                  Send user ID / alias push
                <% :notification -> %>
                  Send notification
              <% end %>
            </.button>
          </div>
        </.form>
      </div>

      <aside class="rounded-4xl border border-base-300 bg-base-200/60 p-6 shadow-sm">
        <div class="space-y-4">
          <div>
            <h2 class="text-lg font-semibold text-base-content">Tips</h2>
            <p class="mt-2 text-sm leading-6 text-base-content/70">
              Keep titles short, make the body clear, and send a JSON object in the data field.
            </p>
          </div>

          <div class="space-y-3 text-sm text-base-content/65">
            <div class="rounded-2xl border border-base-300 bg-base-100 px-4 py-3">
              <p class="font-medium text-base-content">Required fields</p>
              <p class="mt-1">
                <%= case @active_tab do %>
                  <% :device -> %>
                    App ID, auth token, device ID, title, text, and data are all required.
                  <% :user_id_alias -> %>
                    App ID, auth token, title, text, data, and at least one user ID or alias are required.
                  <% :notification -> %>
                    App ID, auth token, title, text, and data are all required.
                <% end %>
              </p>
            </div>

            <div class="rounded-2xl border border-base-300 bg-base-100 px-4 py-3">
              <p class="font-medium text-base-content">Data format</p>
              <p class="mt-1">
                Use valid JSON object syntax such as <code phx-no-curly-interpolation>{"screen":"inbox"}</code>.
              </p>
            </div>

            <div class="rounded-2xl border border-base-300 bg-base-100 px-4 py-3">
              <p class="font-medium text-base-content">API configuration</p>
              <p class="mt-1">
                The page uses the notifications base URL configured in <code>config/runtime.exs</code>.
              </p>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <section
      :if={@result}
      id="notification-result"
      class={[
        "overflow-hidden rounded-4xl border p-6 shadow-lg sm:p-8",
        @result.kind == :success && "border-success/20 bg-success/5 shadow-success/10",
        @result.kind == :error && "border-error/20 bg-error/5 shadow-error/10"
      ]}
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class={[
            "text-sm font-semibold uppercase tracking-[0.22em]",
            @result.kind == :success && "text-success",
            @result.kind == :error && "text-error"
          ]}>
            {if(@result.kind == :success, do: "Success", else: "Error")}
          </p>
          <h2 class="mt-2 text-2xl font-semibold text-base-content">{@result.title}</h2>
        </div>

        <div class={[
          "inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium",
          @result.kind == :success && "bg-success/10 text-success",
          @result.kind == :error && "bg-error/10 text-error"
        ]}>
          <.icon
            name={if(@result.kind == :success, do: "hero-check-badge", else: "hero-x-circle")}
            class="size-5"
          />
          {if(@result.kind == :success, do: "Request queued", else: "Needs attention")}
        </div>
      </div>

      <div class="mt-6 overflow-hidden rounded-2xl border border-base-300 bg-base-300/50">
        <pre class="overflow-x-auto px-4 py-4 text-sm leading-6 text-base-content/80">{formatted_result(@result.payload)}</pre>
      </div>
    </section>
  </section>
</Layouts.app>
